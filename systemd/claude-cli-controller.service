[Unit]
Description=Claude Code CLI Controller (tmux sessions)
After=network-online.target
Wants=network-online.target

[Service]
# Platzhalter <user> und der Installationspfad müssen vor dem Einrichten
# durch die tatsächlichen Werte ersetzt werden (siehe docs/SETUP.md).
Type=simple
User=<user>
Group=<user>
Environment=HOME=/home/<user>
Environment=PATH=/home/<user>/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/home/<user>/claude-cli-controller
ExecStart=/home/<user>/claude-cli-controller/controller.sh supervise
Restart=on-failure
RestartSec=5
# Bewusst KEIN eigenes ExecStop: "controller.sh supervise" faengt TERM
# selbst ab (Trap) und stoppt alle Sessions dort. Ein zusaetzliches
# ExecStop wuerde einen zweiten, parallel laufenden Stop-Pfad erzeugen —
# waehrend der (sequenziell laufende) ExecStop-Prozess Sessions stoppt,
# tickt der Hauptprozess unveraendert weiter und kann bereits gestoppte
# Sessions wieder hochstarten, da er sein eigenes TERM laut systemd erst
# NACH Ende von ExecStop bekommt (live bestaetigt, Robustheits-Review
# 2026-09-24, B2). KillMode=process: Der tmux-Server ist ein eigener,
# sich selbst daemonisierender Prozess (kein Kind dieser Unit) und
# ueberlebt ohnehin jeden Stop dieser Unit - das ist gewollt, Sessions
# sollen einen Neustart/Reboot des Controllers ueberstehen (siehe
# docs/session-lifecycle im knowledge-base-Repo bzw. docs/ARCHITECTURE.md).
# Ein regulaeres "systemctl stop" beendet Sessions trotzdem sauber, weil
# der Trap in "supervise" das selbst uebernimmt, solange TimeoutStopSec
# nicht ueberschritten wird (siehe cmd_stop_all: max. ~10s Wartezeit,
# unabhaengig von der Session-Anzahl).
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
