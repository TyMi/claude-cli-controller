# claude-cli-controller: session definitions
#
# Format (semicolon-separated, no semicolons inside the fields):
#   name;workdir;resume;extra_args;status
#
# name        unique tmux session name. Letters (including umlauts), digits,
#             spaces, "-", "_", max. 64 characters, at least one letter
#             (purely numeric names are rejected) - see docs/SESSIONS.md.
# workdir     working directory for "claude" (empty = $HOME)
# resume      empty = new conversation
#             "last" / "continue" = --continue (continue the last conversation in workdir)
#             <session-uuid> = --resume <session-uuid> (only the UUID format
#             xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx is accepted; anything else
#             is discarded and the session starts without --resume)
# extra_args  additional CLI flags, e.g. --permission-mode acceptEdits
# status      "active" (default, empty = active) or "archived"
#             (archived sessions are skipped by start/supervise)
#
# Normally manage this file via ./controller.sh new / archive / unarchive /
# edit instead of editing it by hand.
#
# Lines starting with "#" and empty lines are ignored.

main;/home/<user>/projects/project-a;;;active
support;/home/<user>/projects/project-b;last;--permission-mode acceptEdits;active
sandbox;/home/<user>/projects/scratch;;;active
